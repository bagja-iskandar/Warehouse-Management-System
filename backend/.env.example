# ==============================================================================
# WMS Nusantara — Backend Environment Configuration Template
# For Render Web Service, configure these in the Render Dashboard Environment tab.
# For local development, copy this file to .env.
# DO NOT COMMIT REAL SECRETS, PASSWORDS, OR PRODUCTION KEYS TO GIT.
# ==============================================================================

# Application Environment (development / production)
NODE_ENV=production

# Server Port (dynamically assigned by Render in production, e.g. 10000; defaults to 5000 locally)
PORT=

# API Global Prefix
API_PREFIX=api/v1

# CORS Allowed Origin(s) (e.g. https://your-frontend.vercel.app or comma-separated list)
CORS_ORIGIN=

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection (Supabase Session Pooler)
# ------------------------------------------------------------------------------
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# JWT Authentication Secrets
# ------------------------------------------------------------------------------
# Generate strong, random 32+ character secrets for production
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRATION=15m

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# Logging Configuration (fatal, error, warn, info, debug, trace, silent)
# ------------------------------------------------------------------------------
LOG_LEVEL=info
