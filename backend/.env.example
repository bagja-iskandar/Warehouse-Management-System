# ==============================================================================
# WMS Nusantara — Backend Environment Configuration Template
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO REPOSITORY
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection (Local pgAdmin & Cloud Ready)
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT (Windows pgAdmin / Local PostgreSQL):
# Format: postgresql://<USERNAME>:<PASSWORD>@localhost:5432/wms_db?schema=public
#
# FUTURE CLOUD PRODUCTION (AWS RDS / Supabase / Neon / Cloud SQL):
# Format: postgresql://<CLOUD_USER>:<CLOUD_PASS>@<CLOUD_HOST>:5432/<CLOUD_DB>?sslmode=require
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/wms_db?schema=public

# JWT Authentication Configuration (Phase 10)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long
JWT_REFRESH_EXPIRATION=7d

# MinIO / S3 Object Storage Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=wms-storage

# Logging Configuration (fatal, error, warn, info, debug, trace, silent)
LOG_LEVEL=debug
